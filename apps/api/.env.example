DATABASE_URL="file:./dev.db"
SESSION_SECRET="troque-por-um-segredo-longo-em-producao"
PORT=3333
WEB_ORIGIN="http://127.0.0.1:5173"

# Em NODE_ENV=production a API não sobe com este SESSION_SECRET, com segredo
# menor que 24 caracteres, ou sem WEB_ORIGIN. O cookie de sessão passa a Secure.

# Chave Pix pública do projeto. Pode ser sobrescrita; não é credencial.
PIX_KEY="futebadosparcas@outlook.com"

# Obrigatórios os dois, com dados reais do recebedor, para gerar BR Code.
# Sem eles o jogo só oferece a chave para copiar e não inventa nome nem cidade.
# PIX_MERCHANT_NAME=""
# PIX_MERCHANT_CITY=""

# Segredo do webhook servidor-a-servidor. Sem ele o checkout permanece indisponível
# e nenhuma intenção é marcada como verificada.
# PAYMENT_WEBHOOK_SECRET=""
