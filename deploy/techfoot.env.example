# O arquivo real fica em /srv/techfernandes/techfoot/techfoot.env
# dono root, modo 0600. O compose só consegue lê-lo se o deploy for com sudo/root.
# NODE_ENV, WEB_ORIGIN e SESSION_SECRET vêm deste arquivo.
# Este exemplo não sobe: o segredo abaixo é recusado. Não commite a cópia real.
NODE_ENV=production
WEB_ORIGIN=https://techfoot.techfernandes.com.br
DATABASE_URL=file:/data/techfoot.db
PORT=3333
TRUST_PROXY=true
PIX_KEY=futebadosparcas@outlook.com
SESSION_SECRET=SUBSTITUA-POR-UM-SEGREDO-EXCLUSIVO

# Os dois juntos, com o nome e a cidade reais do recebedor, se quiser BR Code.
# PIX_MERCHANT_NAME=
# PIX_MERCHANT_CITY=

# Segredo do webhook de um provedor real. Sem ele nada é marcado como verificado.
# Mesmo verificado, esta versão não libera recurso.
# PAYMENT_WEBHOOK_SECRET=
